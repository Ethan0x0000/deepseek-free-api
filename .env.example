# 服务监听设置
HOST=0.0.0.0
PORT=8317
DEBUG=false

# 上下文长度与智能压缩设置 (1M 窗口，300k 压缩阈值)
MAX_CONTEXT_TOKENS=300000
CONTEXT_COMPRESSION_ENABLED=true
RETAIN_RECENT_MESSAGES_COUNT=12
MAX_TOOL_OUTPUT_TOKENS=25000

# 网络超时时间 (秒)
REQUEST_TIMEOUT=180.0

# 会话模式 ('multi' 隔离会话或 'single' 单会话复用)
PROXY_MODE=multi
SINGLE_SESSION_MODE=false
AUTO_CLEAN_WEB_SESSIONS=false

# DeepSeek 凭证 (可通过 credentials.json 或命令行 /token 配置)
DEEPSEEK_BEARER_TOKEN=
